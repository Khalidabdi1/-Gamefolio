{
  "name": "gamefolio",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --output-dir web-dist",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "export:ios": "expo export --platform ios --output-dir ios-dist",
    "sim": "npx native-sim@0.1.0 up --public --agent --minutes 45",
    "format:check": "prettier --check \"app/**/*.tsx\" \"src/**/*.{ts,tsx}\" \"tests/*.ts\""
  },
  "dependencies": {
    "@expo/ui": "~55.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~55.0.31",
    "expo-blur": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-glass-effect": "~55.0.11",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-status-bar": "~55.0.6",
    "lucide-react-native": "^1.47.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  },
  "private": true
}
